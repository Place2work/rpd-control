# Copia a .env.local (Next) y .env (Prisma). Nunca subas los valores reales.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo servidor y scripts (crear-director). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase → Connect → ORM (Prisma). App: pooler en modo transacción; migraciones: conexión directa.
DATABASE_URL=postgresql://postgres.TU-PROYECTO:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.TU-PROYECTO:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Cifrado de NSS/CURP/CLABE e índice ciego. Genera cada una con: openssl rand -base64 32
# Guárdalas también en un gestor de secretos: si se pierden, los datos cifrados no se recuperan.
CIFRADO_LLAVE=
HMAC_LLAVE=

# Tarea diaria: el mismo valor va en Supabase Vault como rpd_cron_secreto
CRON_SECRETO=

# Fases posteriores
RESEND_API_KEY=
LEADS_HMAC_SECRETO=

# Solo `npm run dev` local, para revisar el diseño sin Supabase. Nunca en Vercel.
# RPD_DEMO_SIN_AUTH=1
