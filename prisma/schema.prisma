  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  archivado_at DateTime? @db.Timestamptz(6)

  usuario Usuario @relation("CapEntrevistas", fields: [usuario_id], references: [id])

  @@map("cap_entrevistas")
  @@schema("public")
}

model CapIncidencia {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id     String    @db.Uuid
  caso_id        String?   @db.Uuid
  tipo           String
  severidad      String
  descripcion    String
  accion         String?
  registrada_por String    @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  archivado_at   DateTime? @db.Timestamptz(6)

  usuario Usuario @relation("CapIncidencias", fields: [usuario_id], references: [id])
  caso    Caso?   @relation("CapIncidenciasCaso", fields: [caso_id], references: [id])

  @@map("cap_incidencias")
  @@schema("public")
}

model CapSolicitud {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id String   @db.Uuid
  tipo       String
  referencia String
  estado     String   @default("pendiente")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  usuario Usuario @relation("CapSolicitudes", fields: [usuario_id], references: [id])

  @@map("cap_solicitudes")
  @@schema("public")
}

model CapMeta {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metrica       String
  valor         Decimal  @db.Decimal(6, 4)
  vigente_desde DateTime @db.Date
  created_by    String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([metrica, vigente_desde])
  @@map("cap_metas")
  @@schema("public")
}

// Academia fase D (9.5, 9.6): cambios de parámetros, preguntas en revisión, microlecciones y repasos.
model CapCambioParametro {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parametro_clave String
  valor           String
  anterior        String
  vigente_desde   DateTime  @db.Date
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  procesado_at    DateTime? @db.Timestamptz(6)

  revisiones      CapPreguntaRevision[]
  actualizaciones CapActualizacion[]

  @@unique([parametro_clave, vigente_desde, valor])
  @@map("cap_cambios_parametro")
  @@schema("public")
}

model CapPreguntaRevision {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pregunta     String
  version      Int
  cambio_id    String    @db.Uuid
  estado       String    @default("revisar") // revisar | vigente
  nota         String?
  revisada_por String?   @db.Uuid
  revisada_at  DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  cambio CapCambioParametro @relation(fields: [cambio_id], references: [id])

  @@unique([pregunta, version, cambio_id])
  @@map("cap_preguntas_revision")
  @@schema("public")
}

model CapActualizacion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plantilla       String
  cambio_id       String    @db.Uuid
  parametro_clave String
  vigente_desde   DateTime  @db.Date
  titulo          String
  contenido       String
  preguntas       Json
  estado          String    @default("borrador") // borrador | publicada
  publicada_at    DateTime? @db.Timestamptz(6)
  publicada_por   String?   @db.Uuid
  fecha_limite    DateTime? @db.Date
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  archivado_at    DateTime? @db.Timestamptz(6)

  cambio    CapCambioParametro        @relation(fields: [cambio_id], references: [id])
  aprobadas CapActualizacionUsuario[]

  @@unique([plantilla, vigente_desde])
  @@map("cap_actualizaciones")
  @@schema("public")
}

model CapActualizacionUsuario {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actualizacion_id String   @db.Uuid
  usuario_id       String   @db.Uuid
  aprobada_at      DateTime @default(now()) @db.Timestamptz(6)

  actualizacion CapActualizacion @relation(fields: [actualizacion_id], references: [id])

  @@unique([actualizacion_id, usuario_id])
  @@map("cap_actualizaciones_usuario")
  @@schema("public")
}

model CapRepaso {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id    String    @db.Uuid
  modulo        String
  motivo        String
  fecha_limite  DateTime  @db.Date
  completado_at DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  archivado_at  DateTime? @db.Timestamptz(6)

  @@map("cap_repasos")
  @@schema("public")
}

// Liga privada del calendario (.ics) por usuario; solo el HMAC del token.
model CalendarioToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id    String    @db.Uuid
  token_hash    String    @unique
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  ultimo_uso_at DateTime? @db.Timestamptz(6)
  revocado_at   DateTime? @db.Timestamptz(6)

  @@map("calendario_tokens")
  @@schema("public")
}

model PlantillaContrato {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clase         String    @default("contrato") // contrato | aviso_privacidad
  nombre        String?
  tipo_servicio String?
  version       Int
  cuerpo        String // HTML/Markdown con variables
  vigente_desde DateTime  @db.Date
  vigente_hasta DateTime? @db.Date
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@map("plantillas_contrato")
  @@schema("public")
}

model SolicitudArco {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  persona_id      String    @db.Uuid
  tipo            TipoArco
  fecha_recepcion DateTime  @db.Date
  fecha_limite    DateTime  @db.Date // +20 días
  fecha_respuesta DateTime? @db.Date
  descripcion     String
  respuesta       String?
  evidencia_path  String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  created_by      String?   @db.Uuid

  persona Persona @relation(fields: [persona_id], references: [id])

  @@map("solicitudes_arco")
  @@schema("public")
}

// Esquema separado: la app (rol authenticated) solo tiene SELECT; escribe el trigger SECURITY DEFINER.
model Auditoria {
  id               BigInt   @id @default(autoincrement())
  tabla            String
  registro_id      String // uuid o clave del catálogo
  accion           String // INSERT | UPDATE | ARCHIVE | DELETE | VER_SENSIBLE
  campo            String? // VER_SENSIBLE: nss | curp | clabe | documento
  campos_cambiados String[]
  resaltado        Boolean  @default(false) // tocó SBC, semanas, saldos, montos o comisiones
  antes            Json?
  despues          Json?
  usuario_id       String?  @db.Uuid
  ip               String?
  fecha            DateTime @default(now()) @db.Timestamptz(6)

  @@index([tabla, registro_id])
  @@index([usuario_id, fecha])
  @@map("auditoria")
  @@schema("auditoria")
}
